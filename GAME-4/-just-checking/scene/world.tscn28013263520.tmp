[node name="BossHint_1" parent="." unique_id=710001001 instance=ExtResource("19_hintpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 35.716927, 0.9, -26.367903)
hint_title = "CLUE #1 — THE CAMPFIRE WARNING"
hint_body = "\"So you finally woke up, Roy? Too late.
Your precious Jessica screamed your name as my puppets dragged her deep into the mist.
If you think that little pistol can save her, follow the dirt trail past the wooden crates toward the river... if you dare.\""

[node name="BossHint_2" parent="." unique_id=710001002 instance=ExtResource("19_hintpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -16.951233, 3.3125062, -40.555313)
hint_index = 2
hint_title = "CLUE #2 — THE PUPPET MASTER'S TRAIL"
hint_body = "\"Still breathing? My wooden mannequins were only a warm-up.
I have locked Jessica inside an iron cage beyond the river clearing.
My dark magic shields me as long as my guards stand. Keep walking northwest toward the water... your grave awaits.\""

[node name="BossHint_3" parent="." unique_id=710001003 instance=ExtResource("19_hintpickup")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -14.570932, -0.9485227, -19.78061)
hint_index = 3
hint_title = "CLUE #3 — THE GOLDEN KEY"
hint_body = "\"You can hear the river now, can't you?
I hold the Golden Cage Key right here in my hands.
Step forward into the clearing and face me eye-to-eye, Roy... before I finish her off myself!\""

